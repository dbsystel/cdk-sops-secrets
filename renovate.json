{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automergeStrategy": "squash",
  "rebaseWhen": "auto",
  "minimumReleaseAge": "1 day",
  "enabledManagers": ["gomod", "npm", "mise", "github-actions"],

  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor", "digest", "pinDigest"],
      "groupName": "all minor and patch",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "all major",
      "automerge": false
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "TypeScript 7 (native compiler) is not yet supported by typescript-eslint and ts-jest; lift once both allow >=7",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    }
  ],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "pinDigests": true
}
